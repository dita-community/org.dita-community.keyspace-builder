    <topicref class="- map/topicref " keys="solutions-gallery" xtrc="topicref:2;35:38"
        href="solutions/reference/solutions-gallery.dita" type="reference">
        <topicmeta class="- map/topicmeta " data-topic-id="solutions-gallery">
            <resourceid class="- topic/resourceid " oxy-source="topic" appid="solutions-gallery"/>
            <navtitle class="- topic/navtitle ">Solutions</navtitle>
            <?ditaot gentext?>
            <linktext class="- map/linktext ">Solutions</linktext>
            <?ditaot genshortdesc?>
            <shortdesc class="- map/shortdesc ">With Solutions, enhance the functionality of <ph
                    keyref="var.company-no-reg-tm" class="- topic/ph "
                    xtrc="ph:1;5:96">DITA Community</ph> applications by using them in combination with
                each other.</shortdesc>
        </topicmeta>
        <topicref class="- map/topicref " keys="adding-advanced-risk-assessment-to-your-projects"
            xtrc="topicref:3;38:42"
            href="solutions/concept/adding-advanced-risk-assessment-to-your-projects.dita"
            type="concept">
            <topicmeta class="- map/topicmeta "
                data-topic-id="adding-advanced-risk-assessment-to-your-projects">
                <resourceid class="- topic/resourceid " oxy-source="topic"
                    appid="adding-advanced-risk-assessment-to-your-projects"/>
                <navtitle class="- topic/navtitle ">Improve visibility into organizational risk
                    exposure with advanced project risk assessment</navtitle>
                <?ditaot gentext?>
                <linktext class="- map/linktext ">Improve visibility into organizational risk
                    exposure with advanced project risk assessment</linktext>
                <?ditaot genshortdesc?>
                <shortdesc class="- map/shortdesc ">With advanced risk assessment for your projects,
                    you can easily identify if any projects pose potential organizational risks and
                    quickly decide on mitigating actions. Combine project risk management with
                    enterprise risk management and get better visibility into your organization's
                    overall risk exposure.</shortdesc>
            </topicmeta>
        </topicref>
        <topicref class="- map/topicref " keys="service-operations" xtrc="topicref:4;41:42"
            href="solutions/concept/service-operations.dita" type="concept">
            <topicmeta class="- map/topicmeta " data-topic-id="service-operations">
                <resourceid class="- topic/resourceid " oxy-source="topic"
                    appid="service-operations"/>
                <navtitle class="- topic/navtitle ">Automating and optimizing your services and
                    operations using <ph keyref="var.service-operations-workspace"
                        class="- topic/ph "
                        xtrc="ph:1;5:119">Service Operations Workspace</ph></navtitle>
                <?ditaot gentext?>
                <linktext class="- map/linktext ">Automating and optimizing your services and
                    operations using Service Operations Workspace</linktext>
                <?ditaot genshortdesc?>
                <shortdesc class="- map/shortdesc ">
                    <ph class="- topic/ph "
                        xtrc="ph:2;6:19">You can expand services while reducing costs, delivering
                        high-quality customer and employee experiences, and driving operational
                        resilience. Use a single cloud platform that integrates IT processes such as
                        incident, problem, and change with IT operations such as discovery, business
                        service definitions, service mapping, and event management.</ph>
                </shortdesc>
            </topicmeta>
        </topicref>
        <topicref class="- map/topicref " keys="using-ham-for-esg" otherprops="store-2024-02"
            xtrc="topicref:5;45:42"
            href="solutions/concept/using-ham-for-esg.dita" type="concept">
            <topicmeta class="- map/topicmeta " data-topic-id="using-ham-for-esg">
                <resourceid class="- topic/resourceid " oxy-source="topic" appid="using-ham-for-esg"/>
                <navtitle class="- topic/navtitle ">Track the performance of your IT assets using
                        <ph keyref="var.hardware-asset-mgmt" class="- topic/ph "
                        xtrc="ph:1;8:41">Hardware Asset Management</ph> and <ph
                        keyref="var.sustain-it" class="- topic/ph "
                        xtrc="ph:2;9:32">Sustainable IT</ph></navtitle>
                <?ditaot gentext?>
                <linktext class="- map/linktext ">Track the performance of your IT assets using
                    Hardware Asset Management and Sustainable IT</linktext>
                <?ditaot genshortdesc?>
                <shortdesc class="- map/shortdesc ">The <ph keyref="var.sustain-it"
                        class="- topic/ph "
                        xtrc="ph:3;11:32">Sustainable IT</ph> application enables you to effectively
                    manage and monitor the emissions generated by your hardware assets.
                    Additionally, it enables you to keep track of the energy consumption of your
                    assets and their proper disposal after they reach the end of their
                    lifespan.</shortdesc>
            </topicmeta>
        </topicref>
        <topicref class="- map/topicref " keys="better-tprm-slo" otherprops="store-2023-09-20"
